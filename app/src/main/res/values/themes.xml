<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Volt" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorSecondary">@color/accent_secondary</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>

        <!-- Typography -->
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>

        <!-- Splash Screen (Android 12+) -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/bg_main</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher</item>
    </style>
    
    <style name="Theme.Volt.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/bg_metro_tile</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
