<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/content_main_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Header -->
            <RelativeLayout
                android:id="@+id/layout_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:paddingHorizontal="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true">

                    <TextView
                        android:id="@+id/tv_ciudad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ubicacion_por_defecto"
                        android:textSize="14sp"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:textColor="@color/accent_primary"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/tv_fecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DOMINGO, 24 MAYO"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <ImageButton
                        android:id="@+id/btn_theme_toggle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_metro_tile"
                        android:src="@drawable/ic_moon"
                        android:padding="10dp"
                        app:tint="@color/text_secondary"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/cambiar_tema" />

                    <ImageButton
                        android:id="@+id/btn_info"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_metro_tile"
                        android:contentDescription="Información"
                        android:padding="10dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Price Hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_metro_tile"
                android:padding="24dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/precio_actual"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.2"
                    android:fontFamily="@font/plus_jakarta_sans_medium"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tv_precio_actual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,142"
                        android:textSize="56sp"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unidad_kwh"
                        android:textSize="18sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="12dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Chart Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/evolucion_24h"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.2"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="16dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_metro_tile"
                android:padding="16dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="32dp">

                <com.github.mikephil.charting.charts.CombinedChart
                    android:id="@+id/price_chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>

            <!-- Next Hours -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/proximas_horas"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.2"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="16dp"/>

            <HorizontalScrollView
                android:id="@+id/tiles_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="32dp"
                android:requiresFadingEdge="horizontal"
                android:fadingEdgeLength="40dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/tiles_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp"
                    android:clipToPadding="false">
                    <!-- Tiles added programmatically -->
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Quick Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="18dp"
                android:layout_marginBottom="12dp">

                <!-- Min Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_metro_tile"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/minimo"
                        android:textSize="10sp"
                        android:textColor="@color/text_muted"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tv_precio_mas_barato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,115"
                        android:textSize="24sp"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:textStyle="bold"
                        android:textColor="@color/price_low"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tv_mas_barato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:00"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>

                <!-- Max Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_metro_tile"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/maximo"
                        android:textSize="10sp"
                        android:textColor="@color/text_muted"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tv_precio_mas_caro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,189"
                        android:textSize="24sp"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:textStyle="bold"
                        android:textColor="@color/price_high"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tv_mas_caro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20:00"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Average Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/bg_metro_tile">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/promedio_diario"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.1"/>

                <TextView
                    android:id="@+id/tv_promedio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0,142 €/kWh"
                    android:textSize="18sp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/layout_skeleton"
        layout="@layout/layout_skeleton_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- Error State Layout -->
    <LinearLayout
        android:id="@+id/layout_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_info_outline"
            app:tint="@color/price_high"
            android:layout_marginBottom="24dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_carga_titulo"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_carga_desc"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reintentar"
            android:backgroundTint="@color/accent_primary"
            android:textColor="@color/bg_main"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</FrameLayout>
